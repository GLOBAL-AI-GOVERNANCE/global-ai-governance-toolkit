{
  "authority_effect": "NONE",
  "cli": {
    "check": "gaig check INPUT --outdir DIRECTORY [--fail-on none|high|critical] [--evaluation-time YYYY-MM-DDTHH:MM:SSZ]",
    "normalize": "gaig normalize INPUT --output-json FILE [--output-csv FILE]",
    "profile": "gaig profile PROFILE_ID INPUT --outdir DIRECTORY [--decision-pack-manifest FILE] [--evaluation-time YYYY-MM-DDTHH:MM:SSZ]",
    "verify": "gaig verify OUTPUT_DIRECTORY"
  },
  "decision_pack_manifest": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/decision-pack-manifest.schema.json",
  "governance_handoff": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/governance-decision-handoff.schema.json",
  "profiles": {
    "result_contract": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/profile-result.schema.json",
    "registry": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.8.0/automation/profiles/registry.json",
    "viewer": "./profile-viewer.mjs",
    "maturity": {
      "profile_id": "organizational-ai-maturity-v0.1",
      "browser_route": "./maturity/",
      "framework_id": "unesco-ai-maturity-2025",
      "framework_version": "2025",
      "authority_effect": "NONE",
      "human_review_boundary": "A human determines maturity. Automation only checks whether submitted evidence can carry that determination."
    },
    "authority_effect": "NONE",
    "cli_supported": [
      "auditable-ai-v1",
      "quantum-ai-convergence-v0.1",
      "ciso-ai-risk-v0.1",
      "independent-assurance-v0.1",
      "mission-assurance-v0.1",
      "machine-learning-assurance-v0.1",
      "organizational-ai-maturity-v0.1"
    ],
    "browser_supported": [
      "auditable-ai-v1",
      "quantum-ai-convergence-v0.1",
      "ciso-ai-risk-v0.1",
      "organizational-ai-maturity-v0.1"
    ],
    "supported": [
      "auditable-ai-v1",
      "quantum-ai-convergence-v0.1",
      "ciso-ai-risk-v0.1",
      "organizational-ai-maturity-v0.1"
    ],
    "independent_assurance": {
      "profile_id": "independent-assurance-v0.1",
      "contract_version": "0.2.0",
      "case_contract": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.8.0/automation/contracts/profiles/independent-assurance-case.schema.json",
      "autonomous_agent_requires": [
        "agent_passport_ref",
        "shutdown_evidence"
      ],
      "max_shutdown_test_age_days": 90,
      "boundary": "Checks submitted records. It does not establish that a shutdown test occurred or validate the passport itself.",
      "authority_effect": "NONE"
    }
  },
  "input": {
    "canonical_schema": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/canonical-inventory-record.schema.json",
    "mapping": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/inventory-mapping.json",
    "sample": "./sample-ai-inventory.csv",
    "template": "./ai-system-inventory-template.csv"
  },
  "machine_interface_version": "1.5.0",
  "outputs": [
    "normalized-inventory.json",
    "canonical-inventory.csv",
    "governance-findings.json",
    "governance-result.json",
    "decision-pack/manifest.json",
    "governance-handoff.json",
    "profile-result.json"
  ],
  "product_name": "Global AI Governance Toolkit",
  "purpose": "Normalize an AI-system inventory, apply the bounded governance policy, surface review findings, and prepare a Decision Pack for an accountable human.",
  "repository": "https://github.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit",
  "review_boundary": "Automated evaluation is not deployment approval, certification, compliance determination, proof of safety, risk acceptance, or a transfer of operating authority.",
  "runtime": {
    "backend_required": false,
    "login_required": false,
    "network_requests": false,
    "telemetry": false,
    "upload": false
  },
  "schemas": {
    "findings": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/governance-findings.schema.json",
    "normalized_inventory": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/normalized-inventory.schema.json",
    "result": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/v2.7.2/automation/contracts/v1/governance-result.schema.json"
  },
  "discovery": {
    "llms_txt": "./llms.txt",
    "agent_setup": "./AGENT_SETUP.md",
    "agent_setup_source": "https://github.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/blob/main/docs/AGENT_SETUP.md",
    "human_entry": "./",
    "schema_urls_track": "unchanged schemas keep their v2.7.2 release-tag URLs in v2.8.0; changed contracts and the profile registry are pinned to v2.8.0; this Pages site reflects the main branch",
    "start_here": "./start.html",
    "journeys_guide": "./JOURNEYS.md",
    "journeys_guide_source": "https://github.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/blob/main/docs/JOURNEYS.md",
    "journeys_open_list": "journeys is an open, additive list of worked examples. Entry ids are stable, new entries may be added, no one has to pick one, and every step can be opened directly."
  },
  "journeys": [
    {
      "id": "everyday-ai-apps",
      "audience_examples": [
        "people using ChatGPT, Claude, Grok, Gemini, or Copilot"
      ],
      "entry": "./start.html#apps",
      "needs_terminal": false,
      "steps": [
        {
          "id": "practise-decision",
          "entry": "https://global-ai-governance.github.io/peace-os/"
        },
        {
          "id": "check-your-ai",
          "entry": "./#toolkit",
          "input": "./ai-system-inventory-template.csv"
        },
        {
          "id": "ground-rule",
          "entry": "./start.html#apps",
          "note": "an instruction to the assistant, not a technical control"
        },
        {
          "id": "assistant-setup",
          "entry": "./AGENT_SETUP.md",
          "note": "needs an assistant that can run commands"
        }
      ]
    },
    {
      "id": "ai-organizations-and-agent-fleets",
      "audience_examples": [
        "builders of AI organizations",
        "a lead agent / orchestrator and the people accountable for it"
      ],
      "entry": "./start.html#builders",
      "needs_terminal": true,
      "steps": [
        {
          "id": "inventory",
          "entry": "./AGENT_SETUP.md",
          "command": "gaig check"
        },
        {
          "id": "assess",
          "entry": "./AGENT_SETUP.md",
          "command": "gaig profile"
        },
        {
          "id": "connect",
          "entry": "./connect.html#agents",
          "command": "gaig-mcp"
        },
        {
          "id": "passports",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/agentic-ai-governance",
          "command": "validate-passport"
        },
        {
          "id": "guard",
          "entry": "./connect.html#guard",
          "command": "tool_call_hook.py"
        },
        {
          "id": "fleet-controls",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/agentic-ai-governance/tree/main/conformance/fleet-controls",
          "command": "fleet_controls.py"
        },
        {
          "id": "shutdown-tests",
          "entry": "./JOURNEYS.md",
          "command": "gaig profile independent-assurance-v0.1"
        },
        {
          "id": "vulnerabilities",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/verified-vulnerability-governance",
          "command": "vvd"
        },
        {
          "id": "boundaries",
          "entry": "https://global-ai-governance.github.io/containment-ledger/"
        },
        {
          "id": "resilience",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/ai-cyber-resilience-framework"
        }
      ]
    },
    {
      "id": "frontier-labs",
      "audience_examples": [
        "frontier AI labs",
        "evaluation and safety teams"
      ],
      "entry": "./start.html#labs",
      "needs_terminal": true,
      "steps": [
        {
          "id": "crosswalk",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/GLOBAL-AI-GOVERNANCE/blob/main/docs/FRONTIER_AND_REGULATORY_CROSSWALK.md"
        },
        {
          "id": "contracts",
          "entry": "./machine-interface.json"
        },
        {
          "id": "provenance",
          "entry": "./JOURNEYS.md",
          "command": "gh attestation verify"
        },
        {
          "id": "integrate",
          "entry": "./connect.html#agents"
        },
        {
          "id": "independent-review",
          "entry": "https://github.com/GLOBAL-AI-GOVERNANCE/ai-cyber-resilience-framework/blob/main/docs/crypto-agility-review/README.md",
          "also": [
            "https://github.com/GLOBAL-AI-GOVERNANCE/agentic-ai-governance/blob/main/conformance/independent-verifier/README.md",
            "https://github.com/GLOBAL-AI-GOVERNANCE/governed-systems-administration/tree/main/docs/independent-audit"
          ]
        },
        {
          "id": "non-claims",
          "entry": "./start.html#labs"
        }
      ]
    },
    {
      "id": "anyone",
      "audience_examples": [
        "teams",
        "enterprises",
        "researchers",
        "educators",
        "public-interest bodies",
        "regulators"
      ],
      "entry": "./start.html#anyone",
      "needs_terminal": false,
      "steps": [
        {
          "id": "map",
          "entry": "./start.html#anyone"
        }
      ]
    }
  ],
  "release": "v2.8.0"
}
