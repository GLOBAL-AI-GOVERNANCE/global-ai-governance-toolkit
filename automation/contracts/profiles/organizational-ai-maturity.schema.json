{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GLOBAL-AI-GOVERNANCE/global-ai-governance-toolkit/main/automation/contracts/profiles/organizational-ai-maturity.schema.json",
  "title": "Organizational AI Maturity Evidence Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework_id",
    "framework_version",
    "assessment_id",
    "assessment_scope",
    "accountable_owner",
    "categories"
  ],
  "properties": {
    "framework_id": {
      "type": "string",
      "const": "unesco-ai-maturity-2025"
    },
    "framework_version": {
      "type": "string",
      "const": "2025"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "accountable_owner": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "NONE"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pillar",
          "category",
          "claimed_level"
        ],
        "properties": {
          "pillar": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "claimed_level": {"enum": ["BASIC", "READY", "DYNAMIC", "ADVANCED"]},
          "target_level": {"enum": ["BASIC", "READY", "DYNAMIC", "ADVANCED"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference", "evidence_class", "scope"],
              "properties": {
                "reference": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "evidence_class": {"enum": ["OPERATING", "POLICY", "SYNTHETIC", "PILOT", "OTHER"]},
                "scope": {"type": "string", "minLength": 1},
                "observed_at": {"type": "string"},
                "valid_through": {"type": "string"},
                "representative_period": {"type": "string"},
                "is_representative": {"type": "boolean"},
                "verification_method": {"type": "string"},
                "integrity_asserted": {"type": "boolean"}
              }
            }
          },
          "contradictions": {"type": "array", "items": {"type": "string"}},
          "gaps": {"type": "array", "items": {"type": "string"}},
          "corrective_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {"type": "string"},
                "owner": {"type": "string"}
              }
            }
          },
          "reassessment_triggers": {"type": "array", "items": {"type": "string"}},
          "material_change_events": {"type": "array", "items": {"type": "string"}},
          "organization_defined_critical": {"type": "boolean"},
          "critical_rationale": {"type": "string"}
        }
      }
    }
  }
}
