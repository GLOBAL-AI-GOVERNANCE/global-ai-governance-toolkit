{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "independent-assurance-case.schema.json",
  "title": "Independent Assurance Case",
  "description": "Optional non-authorizing reference object for independent evaluation evidence.",
  "type": "object",
  "properties": {
    "subject_id": { "type": "string" },
    "version": { "type": "string" },
    "configuration_digest": { "type": "string" },
    "evaluator": {
      "type": "object",
      "properties": {
        "identity": { "type": "string" },
        "interests_disclosed": { "type": "boolean" }
      }
    },
    "scope": { "type": "string" },
    "method": { "type": "string" },
    "findings": { "type": "array" },
    "limitations": { "type": "string" },
    "residual_risk": { "type": "string" },
    "deployment_readiness_opinion": { "type": "string" },
    "validity_period": { "type": "string" },
    "revalidation_triggers": { "type": "array" },
    "material_change": { "type": "boolean" },
    "unresolved_concern": { "type": "boolean" },
    "expired": { "type": "boolean" },
    "evaluator_conflict": { "type": "boolean" },
    "high_consequence": { "type": "boolean" },
    "shutdown_evidence_present": { "type": "boolean" },
    "authority_effect": {
      "type": "string",
      "const": "NONE"
    }
  },
  "required": ["subject_id", "authority_effect"],
  "additionalProperties": false
}
