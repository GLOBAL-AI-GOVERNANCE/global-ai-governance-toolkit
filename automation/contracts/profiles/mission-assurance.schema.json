{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-assurance.schema.json",
  "title": "Mission Assurance Interoperability Profile Input",
  "description": "Optional non-authorizing staged mission-assurance review. References do not transfer source authority or truth. A PASS is a bounded structural check only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "mission_objective": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "configuration_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "accountable_human_ref": {"type": "string", "minLength": 1},
    "target_stage": {"type": "string", "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"]},
    "reference_only": {"type": "boolean", "const": true},
    "human_decision_required": {"type": "boolean", "const": true},
    "authority_effect": {"type": "string", "const": "NONE"},
    "known_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocking_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "material_change": {"type": "boolean"},
    "baseline_reference": {"$ref": "#/$defs/evidence"},
    "authority_data_references": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "qualification_reference": {"$ref": "#/$defs/evidence"},
    "adversarial_assurance_reference": {"$ref": "#/$defs/evidence"},
    "human_readiness_reference": {"$ref": "#/$defs/evidence"},
    "operational_acceptance_reference": {"$ref": "#/$defs/evidence"},
    "degraded_mode_reference": {"$ref": "#/$defs/evidence"},
    "recovery_reference": {"$ref": "#/$defs/evidence"},
    "support_owner_reference": {"$ref": "#/$defs/evidence"},
    "succession_reference": {"$ref": "#/$defs/evidence"}
  },
  "required": ["mission_id", "mission_objective", "subject_id", "configuration_digest", "accountable_human_ref", "target_stage", "reference_only", "human_decision_required", "authority_effect", "known_unknowns", "blocking_unknowns", "material_change"],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "artifact_type", "artifact_id", "schema_version", "subject_id", "configuration_digest", "artifact_digest", "authority_effect"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "configuration_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "authority_effect": {"type": "string", "const": "NONE"}
      }
    }
  }
}
